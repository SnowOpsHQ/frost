{
  "format": 1,
  "version": 1,
  "published": "2026-10-28",
  "engines": [
    {
      "id": "google",
      "label": "Google",
      "hosts": [
        "www.google.com",
        "www.google.co.uk",
        "www.google.ca",
        "www.google.com.au",
        "www.google.de",
        "www.google.fr",
        "www.google.es",
        "www.google.it",
        "www.google.co.in",
        "www.google.com.br",
        "www.google.co.jp"
      ],
      "paths": ["/search"],
      "params": {
        "query": ["q"],
        "gl": ["gl"],
        "hl": ["hl"],
        "page": { "param": "start", "kind": "offset", "perPage": 10, "offsetBase": 0 }
      },
      "layout": {
        "results": "#search",
        "blocks": [
          { "type": "ad", "container": "#tads, #bottomads", "item": "[data-text-ad]", "link": "a[href]", "title": "[role=\"heading\"]" },
          { "type": "shopping", "container": ".commercial-unit-desktop-top, .commercial-unit-desktop-rhs", "item": "a[href]" },
          { "type": "featured-snippet", "container": "#rso block-component", "link": "a[href]", "title": "h3" },
          { "type": "people-also-ask", "container": "#rso [data-initq]", "item": "[data-q]" },
          { "type": "video", "container": "#rso video-voyager", "link": "a[href]", "title": "h3" },
          { "type": "images", "container": "#iur", "item": "a[href]" },
          { "type": "organic", "container": "#rso", "item": "a[href]:has(h3)", "title": "h3", "required": true },
          { "type": "knowledge-panel", "container": "#rhs", "title": "[data-attrid=\"title\"]" },
          { "type": "related-searches", "container": "#bres", "item": "a[href]" }
        ]
      }
    },
    {
      "id": "bing",
      "label": "Bing",
      "hosts": ["www.bing.com"],
      "paths": ["/search"],
      "params": {
        "query": ["q"],
        "gl": ["cc"],
        "hl": ["setlang"],
        "page": { "param": "first", "kind": "offset", "perPage": 10, "offsetBase": 1 }
      },
      "layout": {
        "results": "#b_results",
        "blocks": [
          { "type": "ad", "container": "#b_results > li.b_ad", "item": "li", "link": "h2 a[href]", "title": "h2" },
          { "type": "featured-snippet", "container": "#b_results > li.b_ans.b_top", "link": "a[href]" },
          { "type": "organic", "container": "#b_results", "item": "li.b_algo", "link": "h2 a[href]", "title": "h2", "required": true },
          { "type": "related-searches", "container": "#b_results .b_rs", "item": "li a[href]" },
          { "type": "knowledge-panel", "container": "#b_context", "title": "h2" }
        ]
      }
    },
    {
      "id": "duckduckgo",
      "label": "DuckDuckGo",
      "hosts": ["duckduckgo.com", "html.duckduckgo.com"],
      "paths": ["/", "/html", "/html/"],
      "params": {
        "query": ["q"],
        "gl": ["kl"]
      },
      "layout": {
        "results": "[data-testid=\"mainline\"], #links",
        "blocks": [
          { "type": "ad", "container": "[data-testid=\"mainline\"], #links", "item": "[data-testid=\"ad\"], .result--ad", "link": "a[href]", "title": "h2" },
          { "type": "organic", "container": "[data-testid=\"mainline\"], #links", "item": "article[data-testid=\"result\"], .web-result:not(.result--ad)", "link": "a[data-testid=\"result-title-a\"], a.result__a", "title": "h2", "required": true },
          { "type": "related-searches", "container": "[data-testid=\"related-searches\"]", "item": "a[href]" },
          { "type": "knowledge-panel", "container": "[data-area=\"sidebar\"] .module--about", "title": "h2" }
        ]
      }
    }
  ]
}
