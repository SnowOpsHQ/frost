# Copy to .env and fill in for local runs. Placeholders only: never commit real values.

# Postgres URL. Leave unset to use a local PGlite directory (PGLITE_DIR, default ./.data/pglite).
# DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/frost
# PGLITE_DIR=./.data/pglite

# Required: at least 32 characters. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# The public base URL of this backend (default http://127.0.0.1:$PORT).
# BETTER_AUTH_URL=http://127.0.0.1:8787

# `console` prints emails (magic links included) to stdout. Local development only.
EMAIL_TRANSPORT=console

# HOST=127.0.0.1
# PORT=8787
