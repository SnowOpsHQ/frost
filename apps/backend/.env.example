# Copy to .env and fill in for local runs. Placeholders only: never commit real values.

# Postgres URL. Leave unset to use a local PGlite directory (PGLITE_DIR, default ./.data/pglite).
# DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/frost
# PGLITE_DIR=./.data/pglite

# Required: at least 32 characters. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# The public base URL of this backend (default http://127.0.0.1:$PORT).
# BETTER_AUTH_URL=http://127.0.0.1:8787

# Required: the entitlement signing key (a private Ed25519 JWK, JSON in single quotes) and its kid.
# Generate both with `pnpm --filter @app/backend admin keygen` (prints to stdout only). Secret: never
# commit a real key. Its public JWKS goes to the desktop build as FROST_PUBLIC_ENTITLEMENT_JWKS.
ENTITLEMENT_KEY_ID=
ENTITLEMENT_SIGNING_KEY=
# During a key rotation: a JWKS ('{"keys":[...]}') of old public keys that stay published.
# ENTITLEMENT_PUBLIC_KEYS=

# `console` prints emails (magic links included) to stdout. Local development only.
EMAIL_TRANSPORT=console

# development (default), test or production. Production requires DATABASE_URL, an https://
# BETTER_AUTH_URL and an email transport other than console (none exists yet).
# NODE_ENV=development

# HOST=127.0.0.1
# PORT=8787

# Only behind a reverse proxy: the header it sets with the client IP, and the proxies to skip in a
# forwarded chain. Unset: the TCP peer is the client (never set these without a proxy in front).
# CLIENT_IP_HEADER=x-forwarded-for
# TRUSTED_PROXIES=10.0.0.1,192.0.2.0/24

# Do not set BETTER_AUTH_TELEMETRY / BETTER_AUTH_TELEMETRY_ENDPOINT / BETTER_AUTH_TELEMETRY_DEBUG:
# startup refuses them.
