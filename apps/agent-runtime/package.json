    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.90",
    "@ai-sdk/gateway": "4.0.128",
    "@ai-sdk/openai": "4.0.104",
    "@ai-sdk/provider": "4.0.34",
    "@app/ai-skills": "workspace:*",
    "@app/specs": "workspace:*",
    "ai": "7.0.155",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
