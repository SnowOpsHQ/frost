{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    // Node types for the tests only; the engine is plain ECMAScript: `tsconfig.src.json` type-checks
    // it without them, and `purity.test.ts` checks it imports no Electron, DOM, Node or Zod.
    "types": ["node"]
  },
  "include": ["src", "*.ts"]
}
