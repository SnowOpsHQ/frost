{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["FROST_PUBLIC_*", "VITE_*"],
      "outputs": [".vite/**", "out/**", "!out/make/**"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/specs/*.ts", "$TURBO_ROOT$/specs/*.md", "$TURBO_ROOT$/.github/workflows/*.yml", "$TURBO_ROOT$/.github/actions/**/*.yml", "$TURBO_ROOT$/scripts/*.mjs", "$TURBO_ROOT$/package.json"],
      "passThroughEnv": ["FROST_REQUIRE_BUBBLEWRAP", "FROST_REQUIRE_INTENT_MODEL", "FROST_INTENT_MODEL_DIR"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    }
  }
}
